<Window x:Class="ClipVoice.Views.TemplatePopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" ShowActivated="False"
        Topmost="True" SizeToContent="WidthAndHeight" Focusable="False">
    <Window.Resources>
        <Style x:Key="PopupFolderButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#F4F5F8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#2E2950"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#3A3268"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder" Width="252" MaxHeight="500"
            Background="#11141B" BorderBrush="#56506F" BorderThickness="1"
            CornerRadius="13" Padding="9">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="6" Opacity="0.45" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0" MaxHeight="410" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="ItemsHost"/>
            </ScrollViewer>

            <Grid Grid.Row="1" Margin="2,6,2,0" MouseEnter="Footer_MouseEnter">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Background="#282D39"/>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Button Style="{StaticResource PopupFolderButton}" Click="SpeakSelection_Click"
                            ToolTip="Озвучить выделенный текст" Padding="8,5" HorizontalContentAlignment="Center">
                        <TextBlock Text="♫" Foreground="#AAA3FF" FontSize="16" FontWeight="SemiBold"/>
                    </Button>
                    <Button Grid.Column="1" Style="{StaticResource PopupFolderButton}" Click="TranslateSpeakSelection_Click"
                            ToolTip="Перевести и озвучить выделенный текст" Padding="8,5" HorizontalContentAlignment="Center">
                        <TextBlock Text="文♫" Foreground="#AAA3FF" FontSize="15" FontWeight="SemiBold"/>
                    </Button>
                </Grid>
                <Button Grid.Row="2" Style="{StaticResource PopupFolderButton}" Click="CreateFromSelection_Click" Padding="11,9">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="＋" Foreground="#AAA3FF" FontSize="16" Margin="0,0,9,0"/>
                        <TextBlock Grid.Column="1" Text="Создать из выделенного текста" Foreground="#F0EEFF" FontSize="12" FontWeight="SemiBold"/>
                    </Grid>
                </Button>
                <Button Grid.Row="3" Style="{StaticResource PopupFolderButton}" Click="Settings_Click" Padding="11,9">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="⚙" Foreground="#AAA3FF" FontSize="14" Margin="0,0,9,0"/>
                        <TextBlock Grid.Column="1" Text="Настроить шаблоны" Foreground="#DDE0E8" FontSize="12"/>
                    </Grid>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
