<Window x:Class="ClipVoice.Views.QuickTemplateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create template" Width="560" Height="620"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#0D1016" Foreground="#F4F5F8"
        ShowInTaskbar="False" ShowActivated="True" Topmost="True">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#171B24"/>
            <Setter Property="Foreground" Value="#F4F5F8"/>
            <Setter Property="BorderBrush" Value="#343A49"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="CaretBrush" Value="#8A7CFF"/>
        </Style>
        <Style x:Key="QuickFolderItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row" Background="#151A23" BorderBrush="#252C38" BorderThickness="1" CornerRadius="8" Padding="11,8">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#202634"/>
                                <Setter TargetName="Row" Property="BorderBrush" Value="#47516A"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#2A2750"/>
                                <Setter TargetName="Row" Property="BorderBrush" Value="#7868FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#735CFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#202633"/>
            <Setter Property="Foreground" Value="#F4F5F8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Create a template from selection" FontSize="21" FontWeight="SemiBold"/>
        <TextBlock Grid.Row="1" Text="The selected text has been captured. Name the template and choose a folder."
                   Foreground="#9FA8BA" Margin="0,5,0,16" TextWrapping="Wrap"/>

        <StackPanel Grid.Row="2">
            <TextBlock Text="Template name" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <TextBox x:Name="NameBox" MaxLength="120"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,15,0,0">
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="Folder" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="1" Text="choose from the list" Foreground="#7F899C" FontSize="11"/>
            </Grid>
            <Border Background="#111620" BorderBrush="#2A3140" BorderThickness="1" CornerRadius="10" Padding="6">
                <ListBox x:Name="FolderList" Height="155" SelectionChanged="FolderList_SelectionChanged"
                         ItemContainerStyle="{StaticResource QuickFolderItemStyle}"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="▸" Foreground="#8A7CFF" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </StackPanel>

        <StackPanel x:Name="NewFolderPanel" Grid.Row="4" Margin="0,12,0,0" Visibility="Collapsed">
            <TextBlock Text="New folder name" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <TextBox x:Name="NewFolderBox" MaxLength="80"/>
        </StackPanel>

        <Border Grid.Row="5" Margin="0,15,0,0" Background="#121722" BorderBrush="#2A3140" BorderThickness="1" Padding="12" CornerRadius="10">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock Text="Template text" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <ScrollViewer Grid.Row="1" MaxHeight="120" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="PreviewText" Foreground="#C8CFDD" TextWrapping="Wrap"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <Grid Grid.Row="6" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ErrorText" VerticalAlignment="Center" Foreground="#E86A7A" TextWrapping="Wrap"/>
            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Cancel" Margin="8,0,0,0" Click="Cancel_Click"/>
            <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="Create template" Margin="10,0,0,0" Click="Create_Click"/>
        </Grid>
    </Grid>
</Window>
