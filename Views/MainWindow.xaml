<Window x:Class="ClipVoice.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClipVoice" Width="520" Height="760" MinWidth="470" MinHeight="620"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True">
    <Border Background="{StaticResource Bg}" BorderBrush="#303644" BorderThickness="1" CornerRadius="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="38"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                    <Image Width="38" Height="38" Source="/ClipVoice;component/Assets/ClipVoice.png" Stretch="UniformToFill" SnapsToDevicePixels="True"/>
                    <StackPanel Margin="11,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="ClipVoice" Foreground="{StaticResource Text}" FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock x:Name="AppVersionText" Foreground="{StaticResource Muted}" FontSize="10" Margin="7,5,0,0"/>
                        </StackPanel>
                        <TextBlock Text="буфер • перевод • озвучка" Foreground="{StaticResource Muted}" FontSize="10"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                    <Button Content="⌨" Width="42" Click="Hotkeys_Click" ToolTip="Горячие клавиши"/>
                    <Button Content="⚙" Width="42" Click="Settings_Click" ToolTip="Настройки"/>
                    <Button Content="—" Width="42" Click="Hide_Click" ToolTip="Скрыть"/>
                </StackPanel>
            </Grid>

            <TabControl Grid.Row="1" Margin="12,0,12,8" Foreground="{StaticResource Text}">
                <TabItem Header="БУФЕР">
                    <Grid Margin="2,10,2,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Margin="2,0,2,7">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Последние 25" Foreground="{StaticResource Text}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="Очистить" Padding="10,6" Click="ClearHistory_Click" VerticalAlignment="Center"/>
                        </Grid>

                        <ListBox x:Name="HistoryList" Grid.Row="1" ItemsSource="{Binding History}"
                                 SelectionChanged="HistoryList_SelectionChanged" MouseDoubleClick="HistoryList_MouseDoubleClick"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Background" Value="{StaticResource Panel}"/>
                                    <Setter Property="BorderBrush" Value="#272C38"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="1,1"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Card" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="11">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="Background" Value="#202531"/></Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Card" Property="Background" Value="{StaticResource AccentSoft}"/>
                                                        <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                                        <Setter TargetName="Card" Property="BorderThickness" Value="2"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="11,10">
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Preview}" TextWrapping="Wrap" Foreground="{StaticResource Text}" MaxHeight="74"/>
                                            <TextBlock Grid.Column="1" Text="{Binding TimeText}" Foreground="{StaticResource Muted}" FontSize="10" Margin="10,0,0,0"/>
                                        </Grid>
                                        <Border x:Name="ActiveHint" Grid.Row="1" Visibility="Collapsed" Margin="0,8,0,0" Padding="8,5" Background="#3A326D" CornerRadius="7">
                                            <TextBlock Text="✓ Активен   •   Ctrl+V — вставить   •   двойной клик — вставить сразу" Foreground="#E3E0FF" FontSize="10"/>
                                        </Border>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                            <Setter TargetName="ActiveHint" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Border Grid.Row="2" Margin="1,7,1,0" Padding="10,7" Background="#151923" CornerRadius="8">
                            <TextBlock x:Name="HotkeySummaryText" Foreground="{StaticResource Muted}" FontSize="10" TextWrapping="Wrap"/>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="ШАБЛОНЫ">
                    <Grid Margin="2,10,2,0">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <TextBlock x:Name="TemplateMouseHintText" Text="Меню шаблонов" Style="{StaticResource Hint}" Margin="2,0,2,8"/>
                        <Grid Grid.Row="1" Margin="2,0,2,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <ComboBox x:Name="FolderCombo" ItemsSource="{Binding TemplateFolders}" SelectionChanged="FolderCombo_SelectionChanged" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="＋ Новый" Background="{StaticResource Accent}" Click="NewTemplate_Click"/>
                            <Button Grid.Column="2" Content="Папки" Click="ManageTemplates_Click"/>
                        </Grid>
                        <ListBox x:Name="TemplatesList" Grid.Row="2" MouseDoubleClick="TemplatesList_MouseDoubleClick">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Background" Value="{StaticResource Panel}"/>
                                    <Setter Property="BorderBrush" Value="#272C38"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="1,3"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Card" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="11">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="Background" Value="#202531"/></Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Card" Property="Background" Value="{StaticResource AccentSoft}"/>
                                                        <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                                        <Setter TargetName="Card" Property="BorderThickness" Value="2"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="11,5">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" Foreground="{StaticResource Text}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding PreviewContent}" Foreground="{StaticResource Muted}" MaxHeight="38" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" Margin="0,1,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="#352F63" CornerRadius="7" Padding="7,4" VerticalAlignment="Top" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding HotkeyBadge}" Foreground="#D7D2FF" FontSize="10"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </TabItem>
            </TabControl>

            <Border Grid.Row="2" Margin="14,0,14,8" Background="{StaticResource Panel}" CornerRadius="12" Padding="7">
                <UniformGrid Columns="4">
                    <Button Content="▶ Озвучить" Background="{StaticResource AccentSoft}" Click="Speak_Click"/>
                    <Button Content="■ Стоп" Click="Stop_Click"/>
                    <Button Content="🌐 Перевести" Click="Translate_Click"/>
                    <Button Content="🌐 + ▶" Click="TranslateSpeak_Click" ToolTip="Перевести и озвучить"/>
                </UniformGrid>
            </Border>

            <Border Grid.Row="3" Background="#11141B" CornerRadius="0,0,18,18" Padding="14,0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusText" Text="Готово" Foreground="{StaticResource Muted}" FontSize="10" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Border Grid.Column="1" Background="#191E28" CornerRadius="8" Padding="8,4" VerticalAlignment="Center">
                        <TextBlock x:Name="TtsStatusText" Text="TTS: проверка…" Foreground="#D6D9E2" FontSize="10" ToolTip="Состояние движков озвучки"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
