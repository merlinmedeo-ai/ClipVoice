<Window x:Class="ClipVoice.Views.TemplateEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClipVoice template" Width="600" Height="590" MinWidth="540" MinHeight="540"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Bg}" Foreground="{StaticResource Text}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Template" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock Text="Templates are inserted directly into the active field. The system clipboard is not changed." Style="{StaticResource Hint}" Margin="0,3,0,16"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="1. Name" FontWeight="SemiBold" FontSize="15"/>
                <TextBlock Text="For example: Work login, Wi-Fi password, Standard reply." Style="{StaticResource Hint}" Margin="0,2,0,7"/>
                <TextBox x:Name="NameBox"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="2. Template text" FontWeight="SemiBold" FontSize="15"/>
                    <TextBlock x:Name="InsertionHintText" Text="This text will be inserted at the cursor through the template menu or its hotkey." Style="{StaticResource Hint}" Margin="0,2,0,7"/>
                </StackPanel>
                <TextBox x:Name="ContentBox" Grid.Row="1" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="180"/>
            </Grid>
        </Border>

        <Border Grid.Row="3" Background="{StaticResource AccentSoft}" BorderBrush="#6558DD" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="235"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,18,0">
                    <TextBlock Text="3. Options" FontWeight="SemiBold" FontSize="15"/>
                    <TextBlock x:Name="HotkeyHintText" Text="A hotkey is optional: click the field on the right and press a shortcut, such as Ctrl+Alt+1. All templates remain available in the context menu." Foreground="#D7D2FF" TextWrapping="Wrap" Margin="0,3,0,0"/>
                    <CheckBox x:Name="SecretCheck" Content="Hide content in lists (password/token)" Margin="0,11,0,0" ToolTip="Lists will show •••••••• instead of the template text"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Hotkey:" Foreground="#D7D2FF" FontSize="11" Margin="0,0,0,5"/>
                    <TextBox x:Name="HotkeyBox" IsReadOnly="True" PreviewKeyDown="HotkeyBox_PreviewKeyDown" FontSize="16" FontWeight="SemiBold" TextAlignment="Center" MinHeight="42" VerticalContentAlignment="Center" ToolTip="Click and press your shortcut"/>
                    <TextBlock Text="Backspace/Delete — clear" Foreground="#A9A2E9" FontSize="10" Margin="0,5,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="ErrorText" Foreground="#FF8E9B" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Cancel" Click="Cancel_Click"/>
                <Button Content="Save template" Background="{StaticResource Accent}" Click="Save_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
