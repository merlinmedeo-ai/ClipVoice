<Window x:Class="ClipVoice.Views.TemplateEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Шаблон ClipVoice" Width="600" Height="590" MinWidth="540" MinHeight="540"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Bg}" Foreground="{StaticResource Text}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Шаблон" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock Text="Шаблоны вставляются напрямую в активное поле. Системный буфер обмена при этом не меняется." Style="{StaticResource Hint}" Margin="0,3,0,16"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="1. Название" FontWeight="SemiBold" FontSize="15"/>
                <TextBlock Text="Например: Рабочий логин, Wi‑Fi пароль, Стандартный ответ." Style="{StaticResource Hint}" Margin="0,2,0,7"/>
                <TextBox x:Name="NameBox"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="2. Текст шаблона" FontWeight="SemiBold" FontSize="15"/>
                    <TextBlock x:Name="InsertionHintText" Text="Этот текст будет вставлен в место курсора через меню шаблонов или через горячую клавишу шаблона." Style="{StaticResource Hint}" Margin="0,2,0,7"/>
                </StackPanel>
                <TextBox x:Name="ContentBox" Grid.Row="1" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="180"/>
            </Grid>
        </Border>

        <Border Grid.Row="3" Background="{StaticResource AccentSoft}" BorderBrush="#6558DD" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="235"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,18,0">
                    <TextBlock Text="3. Дополнительно" FontWeight="SemiBold" FontSize="15"/>
                    <TextBlock x:Name="HotkeyHintText" Text="Горячая клавиша необязательна: кликни поле справа и нажми сочетание, например Ctrl+Alt+1. Все шаблоны всё равно доступны через контекстное меню." Foreground="#D7D2FF" TextWrapping="Wrap" Margin="0,3,0,0"/>
                    <CheckBox x:Name="SecretCheck" Content="Скрывать содержимое в списках (пароль/токен)" Margin="0,11,0,0" ToolTip="В списках будет показано •••••••• вместо текста шаблона"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Горячая клавиша:" Foreground="#D7D2FF" FontSize="11" Margin="0,0,0,5"/>
                    <TextBox x:Name="HotkeyBox" IsReadOnly="True" PreviewKeyDown="HotkeyBox_PreviewKeyDown" FontSize="16" FontWeight="SemiBold" TextAlignment="Center" MinHeight="42" VerticalContentAlignment="Center" ToolTip="Кликни и нажми своё сочетание клавиш"/>
                    <TextBlock Text="Backspace/Delete — очистить" Foreground="#A9A2E9" FontSize="10" Margin="0,5,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="ErrorText" Foreground="#FF8E9B" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Отмена" Click="Cancel_Click"/>
                <Button Content="Сохранить шаблон" Background="{StaticResource Accent}" Click="Save_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
