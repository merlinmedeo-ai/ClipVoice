<Window x:Class="ClipVoice.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClipVoice Settings" Width="1120" Height="880" MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Bg}" Foreground="{StaticResource Text}">
    <Window.Resources>
        <Style x:Key="ManagerListItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Background" Value="#141821"/>
            <Setter Property="BorderBrush" Value="#252B38"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemRoot" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="10,3">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemRoot" Property="Background" Value="#1C2230"/>
                                <Setter TargetName="ItemRoot" Property="BorderBrush" Value="#3A4356"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemRoot" Property="Background" Value="#2A2750"/>
                                <Setter TargetName="ItemRoot" Property="BorderBrush" Value="#7868FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="4,0,0,15">
            <TextBlock x:Name="SettingsTitleText" Text="ClipVoice Settings" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock Text="Configure the main features here. No API keys or account registration required." Style="{StaticResource Hint}" Margin="0,3,0,0"/>
        </StackPanel>

        <TabControl x:Name="SettingsTabs" Grid.Row="1">
            <TabItem Header="GENERAL">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Read selected text aloud" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="Select text, open the template context menu, and choose “Read selected text aloud”." Style="{StaticResource Hint}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="How to open the panel" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="If the side handle gets in the way, choose the first option. Nothing will remain at the screen edge, and ClipVoice will open only with its global hotkey." Style="{StaticResource Hint}"/>
                                <ComboBox x:Name="PanelOpenMode" Margin="0,12,0,8" MinHeight="38">
                                    <ComboBoxItem Content="Hotkey only — no side handle" Tag="hotkey"/>
                                    <ComboBoxItem Content="Hotkey + side handle" Tag="edge"/>
                                </ComboBox>
                                <TextBlock Text="Change the panel hotkey in the HOTKEYS tab." Style="{StaticResource Hint}" Margin="0,0,0,8"/>
                                <CheckBox x:Name="HideAfterPasteCheck" Content="Hide ClipVoice after pasting"/>
                                <CheckBox x:Name="AutoHidePanelCheck" Content="Hide the panel automatically when clicking outside it"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Startup and storage" Style="{StaticResource SectionTitle}"/>
                                <CheckBox x:Name="AutoStartCheck" Content="Start with Windows"/>
                                <TextBlock Text="History is limited to 25 items. History and templates are encrypted with Windows DPAPI and accessible only to the current Windows user. Hotkey settings contain no secrets and are stored separately." Style="{StaticResource Hint}" Margin="0,7,0,0"/>
                                <TextBlock Text="The audio cache is limited to 500 MB; files older than 30 days are removed automatically." Style="{StaticResource Hint}" Margin="0,9,0,5"/>
                                <Button Content="Open audio cache folder" HorizontalAlignment="Left" Click="OpenAudioCache_Click"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="HOTKEYS">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="How to assign a hotkey" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="Click a field and press the desired shortcut; you do not need to type it. Backspace/Delete clears the field. A global hotkey must include Ctrl, Alt, Shift, or Win." Style="{StaticResource Hint}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="265"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Margin="0,4,18,12"><TextBlock Text="Show / hide panel" FontWeight="SemiBold"/><TextBlock Text="Shows history and templates over the current window." Style="{StaticResource Hint}"/></StackPanel>
                                <TextBox x:Name="PanelHotkey" Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource Accent}" FontWeight="SemiBold" FontSize="15" TextAlignment="Center" ToolTip="Click here and press a new shortcut" Grid.Row="0" Grid.Column="1" IsReadOnly="True" PreviewKeyDown="HotkeyBox_PreviewKeyDown" VerticalAlignment="Center"/>
                                <StackPanel Grid.Row="1" Margin="0,4,18,12"><TextBlock Text="Read aloud" FontWeight="SemiBold"/><TextBlock Text="When auto-capture is enabled, just select the text." Style="{StaticResource Hint}"/></StackPanel>
                                <TextBox x:Name="SpeakHotkey" Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource Accent}" FontWeight="SemiBold" FontSize="15" TextAlignment="Center" ToolTip="Click here and press a new shortcut" Grid.Row="1" Grid.Column="1" IsReadOnly="True" PreviewKeyDown="HotkeyBox_PreviewKeyDown" VerticalAlignment="Center"/>
                                <StackPanel Grid.Row="2" Margin="0,4,18,12"><TextBlock Text="Translate automatically" FontWeight="SemiBold"/><TextBlock Text="The language is detected from the text, not the keyboard layout." Style="{StaticResource Hint}"/></StackPanel>
                                <TextBox x:Name="TranslateHotkey" Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource Accent}" FontWeight="SemiBold" FontSize="15" TextAlignment="Center" ToolTip="Click here and press a new shortcut" Grid.Row="2" Grid.Column="1" IsReadOnly="True" PreviewKeyDown="HotkeyBox_PreviewKeyDown" VerticalAlignment="Center"/>
                                <StackPanel Grid.Row="3" Margin="0,4,18,2"><TextBlock Text="Translate and speak" FontWeight="SemiBold"/><TextBlock Text="The translation is copied and read aloud immediately." Style="{StaticResource Hint}"/></StackPanel>
                                <TextBox x:Name="TranslateSpeakHotkey" Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource Accent}" FontWeight="SemiBold" FontSize="15" TextAlignment="Center" ToolTip="Click here and press a new shortcut" Grid.Row="3" Grid.Column="1" IsReadOnly="True" PreviewKeyDown="HotkeyBox_PreviewKeyDown" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <TextBlock x:Name="HotkeyIssueText" Foreground="#FF8E9B" TextWrapping="Wrap" Margin="6,0,6,8"/>
                        <Button Content="Restore default shortcuts" HorizontalAlignment="Left" Click="ResetHotkeys_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="SPEECH &amp; TRANSLATION">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Speech status" Style="{StaticResource SectionTitle}"/>
                                        <TextBlock Text="ClipVoice automatically switches between two online engines and local Piper. ✓ means speech has succeeded; ◐ means Piper is installed but offline synthesis has not been verified." Style="{StaticResource Hint}"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="{StaticResource AccentSoft}" CornerRadius="9" Padding="10,6" Margin="12,0,0,0" VerticalAlignment="Top">
                                        <TextBlock x:Name="ActiveTtsText" Text="Last: —" Foreground="#DDD9FF" FontWeight="SemiBold"/>
                                    </Border>
                                </Grid>
                                <Grid Margin="0,3,0,7">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <TextBlock Text="●  Edge online" FontWeight="SemiBold" Margin="0,5"/><TextBlock x:Name="EdgeTtsHealthText" Grid.Column="1" Margin="8,5" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Row="1" Text="●  Google fallback" FontWeight="SemiBold" Margin="0,5"/><TextBlock x:Name="GoogleTtsHealthText" Grid.Row="1" Grid.Column="1" Margin="8,5" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Row="2" Text="●  Piper local" FontWeight="SemiBold" Margin="0,5"/><TextBlock x:Name="PiperTtsHealthText" Grid.Row="2" Grid.Column="1" Margin="8,5" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                                </Grid>
                                <Border Background="#11151D" CornerRadius="9" Padding="10" Margin="0,5,0,8">
                                    <TextBlock x:Name="TtsMemoryText" Text="Memory: checking…" Foreground="{StaticResource Muted}"/>
                                </Border>
                                <CheckBox x:Name="AutoPrepareLocalTtsCheck" Content="Prepare a local voice after first use of a language (not at startup)" Margin="0,4,0,5"/>
                                <TextBlock Text="After download, local Piper works without internet. Models stay on disk and load into RAM only while generating speech; the Piper process closes afterward." Style="{StaticResource Hint}" Margin="0,0,0,8"/>
                                <WrapPanel>
                                    <Button Content="Check all, including offline" Click="CheckTts_Click"/>
                                    <Button Content="Compare engine speed" Click="MeasureTtsSpeed_Click"/>
                                    <Button x:Name="PrepareLocalTtsButton" Content="Prepare offline fallback" Background="{StaticResource AccentSoft}" Click="PrepareLocalTts_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Online speech" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="The primary speech engine is Edge Read Aloud, available online without an account or API key. If Edge is temporarily unavailable, ClipVoice automatically tries Google Translate TTS. Choose Russian, Ukrainian, and English Edge voices below; other languages and voices are selected automatically." Style="{StaticResource Hint}"/>
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <TextBlock Text="Russian" VerticalAlignment="Center"/><ComboBox x:Name="RussianVoice" Grid.Column="1" Margin="8,4">
                                        <ComboBoxItem Content="ru-RU-SvetlanaNeural"/><ComboBoxItem Content="ru-RU-DmitryNeural"/>
                                    </ComboBox>
                                    <TextBlock Grid.Row="1" Text="English" VerticalAlignment="Center"/><ComboBox x:Name="EnglishVoice" Grid.Row="1" Grid.Column="1" Margin="8,4">
                                        <ComboBoxItem Content="en-US-EmmaMultilingualNeural"/><ComboBoxItem Content="en-US-AndrewMultilingualNeural"/><ComboBoxItem Content="en-US-AriaNeural"/>
                                    </ComboBox>
                                    <TextBlock Grid.Row="2" Text="Ukrainian" VerticalAlignment="Center"/><ComboBox x:Name="UkrainianVoice" Grid.Row="2" Grid.Column="1" Margin="8,4">
                                        <ComboBoxItem Content="uk-UA-PolinaNeural"/><ComboBoxItem Content="uk-UA-OstapNeural"/>
                                    </ComboBox>
                                </Grid>
                                <TextBlock Text="Speech rate" Margin="0,13,0,4"/>
                                <StackPanel Orientation="Horizontal">
                                    <Slider x:Name="SpeechRate" Minimum="-50" Maximum="100" TickFrequency="10" IsSnapToTickEnabled="True" Width="500"/>
                                    <TextBlock Text="{Binding ElementName=SpeechRate, Path=Value, StringFormat={}{0:0}%}" Margin="14,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="The selected engine applies the speech rate while generating audio; the player uses normal playback speed." Style="{StaticResource Hint}" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Automatic translation" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="ClipVoice detects the language from the text itself. Russian or Ukrainian → English. English, French, German, and other foreign languages → the Russian or Ukrainian language selected below. Keyboard layout does not affect translation direction." Style="{StaticResource Hint}"/>
                                <Grid Margin="0,14,0,4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Translate foreign text into" FontWeight="SemiBold"/>
                                        <TextBlock Text="Used for English, French, and other languages." Style="{StaticResource Hint}" Margin="0,3,12,0"/>
                                    </StackPanel>
                                    <ComboBox x:Name="PreferredTranslationLanguage" Grid.Column="1" MinWidth="210" VerticalAlignment="Center">
                                        <ComboBoxItem Content="Russian" Tag="ru"/>
                                        <ComboBoxItem Content="Ukrainian" Tag="uk"/>
                                    </ComboBox>
                                </Grid>
                                <Border Background="#171B24" CornerRadius="10" Padding="12" Margin="0,10,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Example" FontWeight="SemiBold"/>
                                        <TextBlock Text="English / Français / Deutsch → selected Russian or Ukrainian&#x0a;Russian / Ukrainian → English" Style="{StaticResource Hint}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="After translation, the result becomes the current clipboard content, ready for Ctrl+V. “Translate and speak” also reads the translated text aloud." Style="{StaticResource Hint}" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#171D1B" BorderBrush="#2F5A49" BorderThickness="1" CornerRadius="12" Padding="14">
                            <TextBlock Text="Reliability: Edge and Google may change their unofficial web interfaces, so they are tried first for quality. Piper is a fully local fallback. After its one-time setup, Russian, Ukrainian, and English speech remain available without internet or if both online services fail." Foreground="#C9E6D8" TextWrapping="Wrap"/>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Speech diagnostics" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="ClipVoice does not record detailed events during normal use. Only errors, engine failures, and other faults are logged; speech text is not saved." Style="{StaticResource Hint}" Margin="0,0,0,9"/>
                                <Button Content="Copy error log" HorizontalAlignment="Left" Click="CopyDiagnostics_Click"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="TEMPLATES">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource Panel}" BorderBrush="#262B37" BorderThickness="1" CornerRadius="11" Padding="13" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,18,0" VerticalAlignment="Center">
                                <TextBlock Text="Template menu" FontSize="15" FontWeight="SemiBold"/>
                                <CheckBox x:Name="TemplateMouseGestureCheck" Content="Open with a right-click shortcut" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Shortcut" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,4"/>
                                <ComboBox x:Name="TemplateMouseModifierCombo" MinHeight="36">
                                    <ComboBoxItem Content="Alt + Right-click" Tag="Alt"/>
                                    <ComboBoxItem Content="Ctrl + Right-click" Tag="Ctrl"/>
                                    <ComboBoxItem Content="Shift + Right-click" Tag="Shift"/>
                                    <ComboBoxItem Content="Ctrl + Shift + Right-click" Tag="Ctrl+Shift"/>
                                    <ComboBoxItem Content="Ctrl + Alt + Right-click" Tag="Ctrl+Alt"/>
                                    <ComboBoxItem Content="Alt + Shift + Right-click" Tag="Alt+Shift"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Background="#121620" BorderBrush="#252B38" BorderThickness="1" CornerRadius="10" Padding="10,7" Margin="0,0,0,8">
                        <TextBlock Foreground="{StaticResource Muted}" TextWrapping="Wrap">
                            <Run Text="⋮⋮  Click and drag" FontWeight="SemiBold" Foreground="#CFC9FF"/>
                            <Run Text=" a folder or template to change its order. Drag a template to another folder on the left to move it. The order is saved and used in the context menu."/>
                        </TextBlock>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="330"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{StaticResource Panel}" BorderBrush="#262B37" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Folders" FontSize="17" FontWeight="SemiBold"/>
                                        <TextBlock Text="Drag to change the order" Style="{StaticResource Hint}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="#242A36" CornerRadius="8" Padding="8,4" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ElementName=FolderList, Path=Items.Count, StringFormat={}{0} folders}" Foreground="{StaticResource Muted}" FontSize="10"/>
                                    </Border>
                                </Grid>

                                <ListBox x:Name="FolderList" Grid.Row="1" Margin="0,9,0,8" MinHeight="160"
                                         SelectionChanged="FolderList_SelectionChanged"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         AllowDrop="True"
                                         PreviewMouseLeftButtonDown="FolderList_PreviewMouseLeftButtonDown"
                                         PreviewMouseMove="FolderList_PreviewMouseMove"
                                         DragOver="FolderList_DragOver"
                                         Drop="FolderList_Drop">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource ManagerListItemStyle}">
                                            <Setter Property="MinHeight" Value="34"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="⋮⋮" Foreground="#737D92" FontSize="15" VerticalAlignment="Center" Cursor="SizeAll" ToolTip="Click and drag"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                <Border Grid.Column="2" Background="#242A36" CornerRadius="7" Padding="7,3" Margin="8,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Templates.Count}" Foreground="#AFB8CA" FontSize="10"/>
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Button Content="+ Folder" Background="{StaticResource Accent}" Margin="0,3,4,0" Click="AddFolder_Click"/>
                                    <Button Grid.Column="1" Content="Rename" Margin="4,3,4,0" Click="RenameFolder_Click"/>
                                    <Button Grid.Column="2" Content="Delete" Margin="4,3,0,0" Click="DeleteFolder_Click"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Background="{StaticResource Panel}" BorderBrush="#262B37" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Templates" FontSize="17" FontWeight="SemiBold"/>
                                        <TextBlock Text="Select a template to edit or delete • double-click to edit" Style="{StaticResource Hint}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Background="#242A36" CornerRadius="8" Padding="8,4" VerticalAlignment="Center" Margin="0,0,6,0">
                                            <TextBlock Text="{Binding ElementName=TemplateList, Path=Items.Count, StringFormat={}{0} templates}" Foreground="{StaticResource Muted}" FontSize="10"/>
                                        </Border>
                                        <Button Content="Import TXT" Padding="9,5" Click="ImportTemplates_Click" ToolTip="Add templates from a TXT file"/>
                                        <Button Content="Export TXT" Padding="9,5" Margin="5,0,0,0" Click="ExportTemplates_Click" ToolTip="Save all templates to a TXT file"/>
                                    </StackPanel>
                                </Grid>

                                <ListBox x:Name="TemplateList" Grid.Row="1" Margin="0,9,0,8" MinHeight="160"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         AllowDrop="True"
                                         MouseDoubleClick="TemplateList_MouseDoubleClick"
                                         PreviewMouseLeftButtonDown="TemplateList_PreviewMouseLeftButtonDown"
                                         PreviewMouseMove="TemplateList_PreviewMouseMove"
                                         DragOver="TemplateList_DragOver"
                                         Drop="TemplateList_Drop">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource ManagerListItemStyle}">
                                            <Setter Property="MinHeight" Value="37"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="⋮⋮" Foreground="#737D92" FontSize="15" VerticalAlignment="Center" Cursor="SizeAll" ToolTip="Click and drag"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding PreviewContent}" Foreground="{StaticResource Muted}" FontSize="10" TextTrimming="CharacterEllipsis" MaxHeight="16"/>
                                                </StackPanel>
                                                <Border Grid.Column="2" Background="#352F63" CornerRadius="7" Padding="7,3" Margin="10,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding HotkeyBadge}" Foreground="#D7D2FF" FontSize="9"/>
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Button Content="+ New template" Background="{StaticResource Accent}" Margin="0,3,4,0" Click="AddTemplate_Click"/>
                                    <Button Grid.Column="1" Content="Edit" Margin="4,3,4,0" Click="EditTemplate_Click"/>
                                    <Button Grid.Column="2" Content="Delete" Margin="4,3,0,0" Click="DeleteTemplate_Click"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="SaveStatusText" Foreground="#FF8E9B" TextWrapping="Wrap" VerticalAlignment="Center" Margin="5,0,12,0"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="Cancel" Click="Cancel_Click"/><Button Content="Save changes" Background="{StaticResource Accent}" Click="Save_Click"/></StackPanel>
        </Grid>
    </Grid>
</Window>
