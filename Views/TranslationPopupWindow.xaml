<Window x:Class="ClipVoice.Views.TranslationPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" ShowActivated="True"
        Topmost="True" SizeToContent="Height" Width="380" MaxHeight="350"
        WindowStartupLocation="Manual" Opacity="0" IsHitTestVisible="False">
    <Border Background="#11141B" BorderBrush="#56506F" BorderThickness="1"
            CornerRadius="13" Padding="13">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="6" Opacity="0.45" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="文" Foreground="#AAA3FF" FontSize="16" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="0,0,9,0"/>
                <TextBlock Grid.Column="1" Text="Translation" Foreground="#F0EEFF"
                           FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button Grid.Column="2" Content="×" Click="Close_Click" ToolTip="Close"
                        Foreground="#AEB4C2" Background="Transparent" BorderThickness="0"
                        Padding="8,1" FontSize="16" Focusable="False" Cursor="Hand"/>
            </Grid>
            <TextBlock x:Name="LanguagePairText" Grid.Row="1" Foreground="#AAA3FF"
                       FontSize="10" Margin="0,8,0,7" TextTrimming="CharacterEllipsis"/>
            <TextBox x:Name="TranslationText" Grid.Row="2" MaxHeight="250"
                     Foreground="#F4F5F8" Background="Transparent" BorderThickness="0"
                     FontSize="13" Padding="0" TextWrapping="Wrap" IsReadOnly="True"
                     IsTabStop="False" VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Disabled"/>
        </Grid>
    </Border>
</Window>
